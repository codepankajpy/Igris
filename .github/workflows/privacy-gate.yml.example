# Example PR gate for YOUR dapp repo: fail the PR when a scan of the preview
# build adds a new leak class or drops the privacy score.
#
# Copy into .github/workflows/, adjust the build/serve steps and BASELINE
# handling (commit a baseline report.json, or fetch the latest from main).
name: privacy-gate

on: pull_request

jobs:
  igris:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with:
          version: 9.15.9
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      # Get igris (from this repo; use a pinned ref in real use).
      - run: git clone --depth 1 https://github.com/TODO-human/igris /tmp/igris
      - run: cd /tmp/igris && pnpm install && pnpm exec playwright install chromium chromium-headless-shell
      # Build and serve the dapp under test.
      - run: pnpm install && pnpm build && (npx serve dist -l 4173 &) && sleep 2
      # Scan the preview; write report.json.
      - run: cd /tmp/igris && pnpm igris scan http://localhost:4173 --out /tmp/scan
      # Compare with the committed baseline.
      - run: cd /tmp/igris && pnpm exec tsx scripts/ci-compare.ts $GITHUB_WORKSPACE/privacy-baseline.json /tmp/scan/report.json
