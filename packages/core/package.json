{
  "name": "@igris/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "igris-dist": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts/index.ts",
      "igris-dist": "./dist/contracts/index.js",
      "default": "./src/contracts/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "tldts": "7.4.19",
    "viem": "2.57.16",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "vitest": "5.1.0"
  }
}
