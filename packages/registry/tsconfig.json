{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // Private workspace package consumed from source; the Arkiv SDK's
    // inferred schema types reference internal names that cannot appear in
    // emitted .d.ts files (TS4023).
    "declaration": false
  },
  "include": ["src"],
  // Tests and their fixtures run from source under vitest only.
  "exclude": ["**/*.test.ts", "src/test-fixtures.ts", "**/dist/**", "**/node_modules/**"]
}
