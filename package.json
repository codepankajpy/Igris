{
  "name": "igris-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "IGRIS — open privacy reports for dApps, published on Arkiv.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r build",
    "test": "pnpm -r --no-bail test",
    "test:e2e": "pnpm --filter @igris/scanner test:e2e && pnpm --filter @igris/app test:e2e",
    "api:dev": "pnpm --filter @igris/api dev",
    "api:build": "pnpm --filter @igris/api build",
    "api:start": "pnpm --filter @igris/api start",
    "dev": "pnpm --filter @igris/api dev & pnpm --filter @igris/app dev",
    "scanner:init": "pnpm -s --filter @igris/registry exec tsx src/bin/init-scanner.ts"
  },
  "devDependencies": {
    "@igris/core": "workspace:*",
    "@igris/registry": "workspace:*",
    "@igris/scanner": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
