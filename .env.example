# IGRIS environment reference. Copy what you need; every variable is optional.
#
# IGRIS reads NO private keys from the environment. A node's scanner key (its
# Arkiv publisher) is created once per machine and stored in $IGRIS_HOME
# (mode 0600):
#   dev:       pnpm scanner:init <name>
#   container: node --conditions=igris-dist packages/registry/dist/bin/init-scanner.js <name>
# Locally, put ARKIV_ACCESS_KEY in the gitignored .env.arkiv (the dev/start
# scripts load it); in a deployment, set it in the platform's secret settings.

# --- Arkiv registry -----------------------------------------------------------
# Arkiv access key (it is part of the RPC URL: keep it out of git and logs).
ARKIV_ACCESS_KEY=
# Optional Arkiv RPC override (default: the public Rabdi testnet RPC).
ARKIV_RPC_URL=
# Lifetime of published entities in days, 1-182 (default 180).
ARKIV_EXPIRY_DAYS=
# arkiv | local (default: arkiv when a scanner key exists in IGRIS_HOME, else local).
IGRIS_REGISTRY=
# Scanner profile name or address to publish as (default: the only profile).
IGRIS_SCANNER=
# Comma-separated scanner addresses whose Arkiv entities are read and compared
# (this node's own address is always included).
IGRIS_TRUSTED_SCANNERS=

# --- Storage ------------------------------------------------------------------
# Node identity and scanner keys (default ~/.igris; container: /data/igris-home).
IGRIS_HOME=
# Scan jobs, cached reports, local registry (default ./.igris-data; container: /data/igris-data).
IGRIS_DATA_DIR=

# --- Server -------------------------------------------------------------------
# Listen port (default 3001).
PORT=
# Built website served at / from the same origin (default apps/app/dist when
# built; "off" = API only; container: /app/apps/app/dist).
IGRIS_STATIC_DIR=
# Exact origins allowed by CORS, comma-separated, no "*" (default
# http://localhost:5180,http://127.0.0.1:5180). Not needed when the website is
# served by the API itself (same origin).
IGRIS_ALLOWED_ORIGINS=
# Reverse-proxy hops in front of the API, 0-10 (default 0). Set 1 behind
# Render / Railway / one nginx so rate limits see the real client address.
IGRIS_TRUST_PROXY=

# --- Scans and limits -----------------------------------------------------------
# Concurrent scans, 1-8 (default 1; each is a Chromium).
IGRIS_CONCURRENCY=
# Scans allowed to wait, 0-100 (default 4).
IGRIS_MAX_QUEUED=
# Hard per-scan timeout in ms, 5000-600000 (default 120000).
IGRIS_JOB_TIMEOUT_MS=
# Dwell time per scan phase in ms, 1000-20000 (default 4000).
IGRIS_DWELL_MS=
# Ports a scan target may use (default 80,443). Egress is always public-only.
IGRIS_ALLOWED_PORTS=
# POST requests per client per window (default 5).
IGRIS_RATE_LIMIT_MAX=
# Expensive reads per client per window (default 120).
IGRIS_READ_RATE_LIMIT_MAX=
# Rate-limit window in ms, 1000-3600000 (default 60000).
IGRIS_RATE_LIMIT_WINDOW_MS=

# --- Scan-request worker (answers open igris.request.v1 entities) --------------
# 1 | 0 (default: on in Arkiv mode, off in local mode).
IGRIS_WORKER=
# Poll interval in ms (default 15000).
IGRIS_WORKER_POLL_MS=
# How far back requests are read, in seconds (default 3600).
IGRIS_REQUEST_WINDOW_S=
# Requests fulfilled per creator per hour (default 5).
IGRIS_REQUESTS_PER_CREATOR=
# Comma-separated creator addresses whose requests are ignored.
IGRIS_BLOCKED_REQUESTERS=
