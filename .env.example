# IGRIS reads NO private keys from the environment. Scanner keys are created
# per machine with `pnpm igris scanner init --name <name>` and stored in
# $IGRIS_HOME (default ~/.igris, mode 0600). See docs/CONTRACTS.md.

# Optional: where scanner identities live (default ~/.igris).
IGRIS_HOME=

# Optional: override the Arkiv RPC endpoint (defaults to the public testnet RPC).
ARKIV_RPC_URL=

# Optional: Arkiv Hub access key (rate limits; not a secret).
ARKIV_ACCESS_KEY=
