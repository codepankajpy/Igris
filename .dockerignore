# Keep secrets, local state and host build output out of the Docker build
# context. The image builds everything (packages, api, website) itself.
.env
.env.*
!.env.example
**/.igris*
.git
.claude
**/node_modules
**/dist
**/*.tsbuildinfo
**/coverage
**/test-results
**/playwright-report
.trash-node_modules
**/.DS_Store
igris-out
reports
**/*.log
